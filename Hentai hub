function startAutoLeft()
if autoLeftConn then autoLeftConn:Disconnect() end
State.autoLeftPhase = 1
autoLeftConn = RunService.Heartbeat:Connect(function()
if not State.autoLeftEnabled then return end
local root = getHRP()
local hum = getHum()
