unwalkAnimateRef.Disabled = false
end
unwalkAnimateRef = nil
end

-- ============================================================
-- DROP BRAINROT
-- ============================================================
local DROP_ASCEND_DURATION = 0.2
local DROP_ASCEND_SPEED = 150
local DROP_POP_SPEED = 60
local dropConns = {}

function runDropBrainrot()
if State.dropEnabled then return end
State.dropEnabled = true
task.spawn(function()
local c = LP.Character
local root = c and c:FindFirstChild("HumanoidRootPart")
local hum = c and c:FindFirstChildOfClass("Humanoid")
if not root or not hum then State.dropEnabled = false; return end

-- Phase 1: ascend quickly
local ascendConn = RunService.Heartbeat:Connect(function()
if not State.dropEnabled then ascendConn:Disconnect(); return end
if root and root.Parent then
root.AssemblyLinearVelocity = Vector3.new(
root.AssemblyLinearVelocity.X,
DROP_ASCEND_SPEED,
root.AssemblyLinearVelocity.Z
)
end
end)
table.insert(dropConns, ascendConn)
task.wait(DROP_ASCEND_DURATION)
ascendConn:Disconnect()

-- Phase 2: pop off
if root and root.Parent then
local fwd = root.CFrame.LookVector
root.AssemblyLinearVelocity = Vector3.new(
fwd.X * DROP_POP_SPEED,
-DROP_POP_SPEED,
fwd.Z * DROP_POP_SPEED
)
end

task.wait(0.15)
State.dropEnabled = false
for _, cn in ipairs(dropConns) do
pcall(function() cn:Disconnect() end)
end
dropConns = {}
end)
end

