-- Anti-Ragdoll
function startAntiRagdoll()
    if State.antiRagdollConn then return end
    State.antiRagdollConn = RunService.Heartbeat:Connect(function()
        if not State.antiRagdollEnabled then return end
        local char = LP.Character
        if not char then return end
        local hum = getHum(char)
        local hrp = getHRP(char)
        if not hum or not hrp then return end
        if hum.Health <= 0 then return end
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.FallingDown then
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            hrp.Velocity = Vector3.zero
            hrp.RotVelocity = Vector3.zero
        end
    end)
end
function stopAntiRagdoll()
    if State.antiRagdollConn then State.antiRagdollConn:Disconnect(); State.antiRagdollConn = nil end
end

-- Auto Left / Right
local autoLeftConn, autoRightConn
function startAutoLeft()
    if autoLeftConn then autoLeftConn:Disconnect() end
    State.autoLeftPhase = 1
    autoLeftConn = RunService.Heartbeat:Connect(function()
        if not State.autoLeftEnabled then return end
        local hrp = getHRP()
        local hum = getHum()
        if not hrp or not hum then return end
        local spd = State.normalSpeed
        if State.speedMode == "Carry" then spd = State.carrySpeed elseif State.speedMode == "Lagger" then spd = State.laggerSpeed end
        local p = hrp.Position
        if State.autoLeftPhase == 1 then
            local t = Vector3.new(POS.L1.X, p.Y, POS.L1.Z)
            if (t-p).Magnitude < 1 then State.autoLeftPhase = 2 return end
            local dir = (POS.L1 - p).Unit
            hum:Move(dir, false)
            hrp.AssemblyLinearVelocity = Vector3.new(dir.X*spd, hrp.AssemblyLinearVelocity.Y, dir.Z*spd)
        elseif State.autoLeftPhase == 2 then
            local t = Vector3.new(POS.L2.X, p.Y, POS.L2.Z)
            if (t-p).Magnitude < 1 then
                hum:Move(Vector3.zero, false)
                hrp.AssemblyLinearVelocity = Vector3.zero
                State.autoLeftPhase = 0
                task.delay(0.3, function() if State.autoLeftEnabled then State.autoLeftPhase = 3 end end)
                return
            end
            local dir = (POS.L2 - p).Unit
            hum:Move(dir, false)
            hrp.AssemblyLinearVelocity = Vector3.new(dir.X*spd, hrp.AssemblyLinearVelocity.Y, dir.Z*spd)
        elseif State.autoLeftPhase == 3 then
            local t = Vector3.new(POS.L1.X, p.Y, POS.L1.Z)
            if (t-p).Magnitude < 1 then State.autoLeftPhase = 4 return end
            local dir = (POS.L1 - p).Unit
            hum:Move(dir, false)
            hrp.AssemblyLinearVelocity = Vector3.new(dir.X*spd, hrp.AssemblyLinearVelocity.Y, dir.Z*spd)
        elseif State.autoLeftPhase == 4 then
            local t = Vector3.new(POS.L3.X, p.Y, POS.L3.Z)
            if (t-p).Magnitude < 1 then
                hum:Move(Vector3.zero, false)
                hrp.AssemblyLinearVelocity = Vector3.zero
                State.autoLeftEnabled = false
                if stackRefs.left then stackRefs.left.UpdateBg(false) end
                return
            end
            local dir = (POS.L3 - p).Unit
            hum:Move(dir, false)
            hrp.AssemblyLinearVelocity = Vector3.new(dir.X*spd, hrp.AssemblyLinearVelocity.Y, dir.Z*spd)
        end
    end)
end
