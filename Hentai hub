-- Bat Aimbot
local function getClosestPlayer()
    local hrp = getHRP()
    if not hrp then return nil end
    local closest, minDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local targetHRP = getHRP(plr.Character)
            local hum = getHum(plr.Character)
            if targetHRP and hum and hum.Health > 0 then
                local d = (targetHRP.Position - hrp.Position).Magnitude
                if d < minDist then
                    minDist = d
                    closest = targetHRP
                end
            end
        end
    end
    return closest
end

RunService.Heartbeat:Connect(function()
    if not State.batAimbotToggled then return end
    local char = LP.Character
    local hrp = getHRP(char)
    if not hrp then return end
    local target = getClosestPlayer()
    if target then
        local angle = tick() * 25
        local offset = Vector3.new(math.sin(angle)*AUTO_BAT_RADIUS, 0, math.cos(angle)*AUTO_BAT_RADIUS)
        hrp.CFrame = CFrame.new(target.Position + offset, target.Position)
        hrp.AssemblyLinearVelocity = Vector3.zero
        if State.autoSwingEnabled then
            local bat = char:FindFirstChild("Bat") or LP.Backpack:FindFirstChild("Bat")
            if bat then
                pcall(function() bat:Activate() end)
            end
        end
    end
end)

-- Bat Counter
local batCounterConn
function startBatCounter()
    if batCounterConn then return end
    batCounterConn = RunService.Heartbeat:Connect(function()
        if not State.batCounterEnabled or State.batCounterDebounce then return end
        local char = LP.Character
        if not char then return end
        local hum = getHum(char)
        if not hum then return end
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.FallingDown then
            State.batCounterDebounce = true
            task.spawn(function()
                local bat = char:FindFirstChild("Bat") or LP.Backpack:FindFirstChild("Bat")
                if bat then
                    if bat.Parent ~= char then
                        pcall(function() hum:EquipTool(bat) end)
                        task.wait(0.05)
                    end
                    pcall(function() bat:Activate() end)
                    task.wait(0.15)
                    pcall(function() bat:Activate() end)
                end
                task.wait(0.5)
                State.batCounterDebounce = false
            end)
        end
    end)
end
function stopBatCounter()
    if batCounterConn then batCounterConn:Disconnect(); batCounterConn = nil end
    State.batCounterDebounce = false
end

-- Drop Brainrot
local function runDropBrainrot()
    if State.dropEnabled then return end
    State.dropEnabled = true
    task.spawn(function()
        local char = LP.Character
        local hrp = getHRP(char)
        if not hrp then State.dropEnabled = false return end
        hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 150, hrp.AssemblyLinearVelocity.Z)
        task.wait(0.2)
        if hrp and hrp.Parent then
            local fwd = hrp.CFrame.LookVector
            hrp.AssemblyLinearVelocity = Vector3.new(fwd.X*60, -60, fwd.Z*60)
        end
        task.wait(0.15)
        State.dropEnabled = false
    end)
end

-- TP Down
local function doTpDown()
    local char = LP.Character
    local hrp = getHRP(char)
    if not hrp then return end
    local ray = RaycastParams.new()
    ray.FilterDescendantsInstances = {char}
    ray.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(hrp.Position, Vector3.new(0, -500, 0), ray)
    if result then
        hrp.CFrame = CFrame.new(result.Position + Vector3.new(0, hrp.Size.Y/2 + 0.5, 0))
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
end

-- Auto Steal
local stealConn
local function findNearestPrompt()
    local hrp = getHRP()
    if not hrp then return nil end
    local nearest, bestDist = nil, STEAL_RADIUS
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            local parent = desc.Parent
            if parent and parent:IsA("BasePart") then
                local d = (parent.Position - hrp.Position).Magnitude
                if d <= bestDist then
                    bestDist = d
                    nearest = desc
                end
            end
        end
    end
    return nearest
end

local function executeSteal(prompt)
    if State.isStealing then return end
    State.isStealing = true
    if fireproximityprompt then
        fireproximityprompt(prompt, STEAL_DURATION)
    else
        prompt.HoldDuration = STEAL_DURATION
        prompt:Prompt()
    end
    task.wait(STEAL_DURATION + 0.1)
    State.isStealing = false
end

function startAutoSteal()
    if stealConn then return end
    stealConn = RunService.Heartbeat:Connect(function()
        if not State.StealAutoEnabled then return end
        local p = findNearestPrompt()
        if p then executeSteal(p) end
    end)
end
function stopAutoSteal()
    if stealConn then stealConn:Disconnect(); stealConn = nil end
    State.isStealing = false
end

-- Unwalk
local unwalkConn, originalAnimate
function startUnwalk()
    local char = LP.Character
    if char then
        local anim = char:FindFirstChild("Animate")
        if anim and anim:IsA("LocalScript") then
            anim.Disabled = true
            originalAnimate = anim
        end
    end
    if unwalkConn then unwalkConn:Disconnect() end
    unwalkConn = RunService.Heartbeat:Connect(function()
        if not State.unwalkEnabled then return end
        local hum = getHum()
        if hum then
            for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                track:Stop(0)
            end
        end
    end)
end
function stopUnwalk()
    if unwalkConn then unwalkConn:Disconnect(); unwalkConn = nil end
    if originalAnimate and originalAnimate.Parent then
        originalAnimate.Disabled = false
    end
end

