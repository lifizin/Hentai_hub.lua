local _autoBatTarget = nil
local _autoBatLastScan = 0

local function getClosestPlayer()
local root = getHRP()
if not root then return nil end
local now = tick()
if now - _autoBatLastScan <= 0.1 and _autoBatTarget and _autoBatTarget.Parent then
local hum2 = _autoBatTarget.Parent:FindFirstChildOfClass("Humanoid")
if hum2 and hum2.Health > 0 then return _autoBatTarget end
end
_autoBatLastScan = now
_autoBatTarget = nil
local closest, minDist = nil, math.huge
for _, plr in ipairs(Players:GetPlayers()) do
if plr ~= LP and plr.Character then
local tRoot = plr.Character:FindFirstChild("HumanoidRootPart")
local hum2 = plr.Character:FindFirstChildOfClass("Humanoid")
if tRoot and hum2 and hum2.Health > 0 then
local dist = (tRoot.Position - root.Position).Magnitude
if dist < minDist then
minDist = dist
closest = tRoot
end
end
end
end
_autoBatTarget = closest
return _autoBatTarget
end

