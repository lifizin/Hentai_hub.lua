if inp == dragInput and dragging and not State.uiLocked then
mainOuter.Position = UDim2.new(
startPos.X.Scale, startPos.X.Offset + (inp.Position.X - dragStart.X),
startPos.Y.Scale, startPos.Y.Offset + (inp.Position.Y - dragStart.Y)
)
end
end)
